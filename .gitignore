# ============================================================
# busTaams 프로젝트 루트 .gitignore
# 환경변수·비밀키·빌드 산출물을 GitHub 에서 완전히 제외한다.
# ============================================================

# ── 환경변수 파일 (절대 커밋 금지) ──────────────────────────
**/.env
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production
**/.env.local.backup

# ── Firebase Admin 비공개 키 (절대 커밋 금지) ───────────────
**/firebase-admin-key.json
**/*-service-account*.json
**/*-credentials*.json

# ── 의존성 패키지 (용량 크고 재설치 가능) ───────────────────
**/node_modules/

# ── 프론트엔드 빌드 산출물 ──────────────────────────────────
busTaams_web/dist/
busTaams_web/dist-ssr/
busTaams_admin/dist/
busTaams_app/dist/
busTaams_app/.firebase/

# ── 에디터 / OS 임시 파일 ───────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── 로그 파일 ───────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── 업로드된 파일 (사용자 데이터) ────────────────────────────
**/uploads/

# ── 데이터베이스 파일 ────────────────────────────────────────
*.db
*.sqlite

# ── Visual Studio / Windows 잡파일 (구 busTaams_web/.gitignore 통합) ──
*.suo
*.ntvs*
*.njsproj
*.sln

# ── 서버 로컬 업로드 (구 busTaams_server/.gitignore 통합) ──
busTaams_server/uploads/signatures/

# ── Antigravity 임시 작업용 디렉터리 ──
**/scratch/

